# Copy to .env.local and fill in. Both are optional.
# Google Analytics 4 measurement ID (loaded only when set, after first paint)
VITE_GA_ID=
# Google Ads tag + conversion label are built in; override only if you change Ads accounts
# VITE_ADS_ID=
# VITE_ADS_CONTACT_LABEL=
# Formspree (or similar) endpoint: also emails each contact-form booking
VITE_FORM_ENDPOINT=
